# Backend (local dev only). Netlify Functions ignore PORT.
PORT=8787

# Frontend. Leave empty to call the same origin at /api
# (Vite proxies /api to the local backend in dev; Netlify redirects /api/* to the function).
# Set it only if the API is hosted on a different origin, e.g. https://my-api.example.com/api
VITE_API_BASE_URL=
